# AI会社の本体（server）環境変数のサンプル
# これをコピーして .env を作り、値を埋めてください（.env は git 管理外）。
# トークン類は自分のPCの .env / デプロイ先の環境変数にだけ置きます。ここには絶対に実値を書かないこと。

# ---- 基本 ----
PORT=3000
# 外向き操作（送信・予定作成）を承認なしで実行しない（推奨 true）
REQUIRE_APPROVAL=true

# ---- Google（メール・カレンダー連携／パート1）----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- LINE（外出先から指示／パート2）----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# 本人以外の指示を無視したいとき（任意）
LINE_OWNER_USER_ID=

# ---- AI 応答（任意）----
ANTHROPIC_API_KEY=

# ---- Slack秘書（未対応タスクの洗い出し）----
# search:read スコープを持つ「ユーザートークン(xoxp-)」。ボットトークン(xoxb-)では検索できません。
SLACK_USER_TOKEN=xoxp-...
# 追いかけたい相手のSlackユーザーID（既定：下記）
SLACK_TARGET_USER=U07G2BM07LZ
# 何日さかのぼるか（既定 60）
SLACK_LOOKBACK_DAYS=60
